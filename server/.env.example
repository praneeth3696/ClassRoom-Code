# ---------------------------------------------------------------------------
# Server configuration. Copy to .env and fill in for your environment.
# Every value below has a working development default, so an empty .env boots.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000

# Database ------------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the server falls back to
# PGlite (Postgres 16 in WASM) stored under server/.data/pgdata, no install
# needed. Set it to a real Postgres server for staging/production.
# DATABASE_URL=postgres://user:password@localhost:5432/classroom
# PGLITE_DIR=./.data/pgdata

# Auth ----------------------------------------------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me
SESSION_DAYS=7
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Restrict sign-in to the college's domain(s). Empty = allow any domain.
# ALLOWED_EMAIL_DOMAINS=college.edu
# Emails provisioned as teachers on first sign-in. Everyone else is a student.
# TEACHER_EMAILS=anita.rao@college.edu,vikram.shah@college.edu
DEFAULT_DEPARTMENT=Computer Science
# Password-less local sign-in for development. MUST be off in production.
DEV_LOGIN=true

# Worksheet import ----------------------------------------------------------
# Lets a teacher upload a problem sheet and have the worksheet drafted from it.
# Without a key the import page says so and worksheets are written by hand.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
IMPORT_MAX_BYTES=10485760

# Code execution ------------------------------------------------------------
# Self-hosted Judge0 CE (docker compose up in a judge0 checkout). When unset,
# code runs locally instead — see ALLOW_LOCAL_EXECUTION below.
# JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=
JUDGE0_CPU_LIMIT=5
JUDGE0_WALL_LIMIT=10
JUDGE0_MEMORY_KB=256000
# When Judge0 is unreachable, run code in a local subprocess instead. This is a
# development convenience only — it does NOT sandbox student code.
ALLOW_LOCAL_EXECUTION=true
# At most this many Runs/Submits execute at once; the rest wait in a queue.
# QUESTIONS.md measured ~2 GB for 60 simultaneous database runs, so this is what
# keeps a full lab session inside the VM's memory. Size it to the machine.
EXECUTION_CONCURRENCY=8
# Requests beyond this many waiting, or waiting longer than the timeout, get a
# 503 "server is busy, try again" rather than piling up.
EXECUTION_QUEUE_LIMIT=200
EXECUTION_QUEUE_TIMEOUT_MS=60000

# Rate limits -----------------------------------------------------------------
# Counted per signed-in user (so a lab behind one NAT address is not one
# allowance), per IP for sign-in. Exceeding one returns 429 with Retry-After.
# Off automatically under NODE_ENV=test; set RATE_LIMIT_ENABLED=false to disable.
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_RUNS_PER_MINUTE=60
RATE_LIMIT_SUBMITS_PER_MINUTE=20
RATE_LIMIT_SIGNINS_PER_MINUTE=30
# Uploading, analysing and re-checking problem sheets (the analysis calls the model).
RATE_LIMIT_IMPORTS_PER_HOUR=30
